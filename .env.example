# Preflight — optional LLM narration config (NOT required)
# Copy this file to `.env` and fill in a real key ONLY if you want the
# `--llm` voice. Preflight is fully functional without it: the default
# explanation is a deterministic template (zero network, zero keys).
#
# Key formats by provider:
#   Anthropic:      sk-ant-...
#   Any Anthropic-compatible gateway: its own key + base URL below.
#
# NOTE: the agentrouter "sk-B..." key used to run Claude Code CANNOT be
# used here — that router rejects requests from non-Claude-Code clients.
#
# PREFLIGHT_LLM_API_KEY=sk-ant-your-real-key
# PREFLIGHT_LLM_MODEL=claude-sonnet-4-5
# PREFLIGHT_LLM_BASE_URL=https://api.anthropic.com

# These vars never touch this machine's ANTHROPIC_* (Claude Code session) env.
